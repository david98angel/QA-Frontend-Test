{
  "name": "qa-frontend-test",
  "version": "1.0.0",
  "description": "Suite de pruebas automatizadas para Sauce Demo usando Playwright + Cucumber (TypeScript) con Page Object Model",
  "type": "commonjs",
  "scripts": {
    "test": "cucumber-js",
    "test:login": "cucumber-js --tags @login",
    "test:cart": "cucumber-js --tags @cart",
    "test:checkout": "cucumber-js --tags @checkout",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:debug": "cross-env HEADLESS=false SLOWMO=300 cucumber-js",
    "report": "node scripts/generate-report.js",
    "postinstall": "playwright install chromium"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "typescript",
    "bdd",
    "page-object-model",
    "saucedemo"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "cross-env": "^10.1.0",
    "cucumber-html-reporter": "^7.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
